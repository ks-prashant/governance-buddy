# Grounded Governance — environment variables.
#
# In production these are set as Lovable Cloud / Supabase secrets and referenced
# only inside the TanStack server layer (never the browser). For local ingestion
# and eval scripts, copy this file to `.env` (git-ignored) and fill real values.

# --- Model / embedding provider keys (server-only) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Supabase (Lovable Cloud) ---
# Public/anon values are safe for the client; the service-role key is SECRET and
# used ONLY by local ingestion scripts and trusted server code — never the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for ingestion / migrations (from Lovable Cloud settings).
DATABASE_URL=

# --- Optional model routing overrides (defaults live in src/server/pipeline/config.ts) ---
# MODEL_CLASSIFY=claude-haiku-4-5
# MODEL_GENERATE=claude-opus-4-8
# MODEL_VALIDATE=claude-haiku-4-5
# MODEL_FOLLOWUP=claude-opus-4-8

# --- Embedding model + dimension (MUST match the vector(D) column in the schema) ---
# EMBEDDING_MODEL=voyage-3-large
# EMBEDDING_DIM=1024
